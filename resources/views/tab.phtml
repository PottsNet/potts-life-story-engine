            // 0.9.0-alpha.3: curate each chapter like a published story.
            // Illustrations come immediately after the narrative, followed by
            // the key events and then the expandable supporting records.
            $chapterMediaItems = $chapterData->items->filter(static function ($item): bool {
                return $item instanceof StoryGroup
                    && (str_starts_with($item->key, 'illustrations-') || $item->key === 'memories');
            })->values();
            $chapterRecordItems = $chapterData->items->reject(static function ($item): bool {
                return $item instanceof StoryGroup
                    && (str_starts_with($item->key, 'illustrations-') || $item->key === 'memories');
            })->values();
            $chapterItems = $chapterMediaItems->concat($chapterRecordItems);
            ?>
            <div class="potts-story-events">
                <?php $shownRecordDivider = false; ?>
                <?php foreach ($chapterItems as $item) : ?>
                    <?php
                    $itemIsMediaGroup = $item instanceof StoryGroup
                        && (str_starts_with($item->key, 'illustrations-') || $item->key === 'memories');
                    if (!$itemIsMediaGroup && !$shownRecordDivider && $chapterMediaItems->isNotEmpty()) :
                        $shownRecordDivider = true;
                    ?>
                        <div class="potts-story-chapter__supporting-heading">
                            <span aria-hidden="true"></span>
                            <h4><?= I18N::translate('Key events and supporting records') ?></h4>
                        </div>
                    <?php endif ?>
                    <?php if ($item instanceof StoryGroup) : ?>
                        <?php $isIllustrationGroup = str_starts_with($item->key, 'illustrations-') || $item->key === 'memories'; ?>
                        <?php if ($isIllustrationGroup) : ?>
                            <?php
                            // Resolve the chapter media into three deliberate groups:
                            // photographs, documentary records and title-only references.
                            $visualMediaEvents = $item->events->filter(static function (StoryEvent $event): bool {
                                $target = $event->media ?? $event->fact->target();
                                return $target instanceof Media && !$target->mediaFiles()->isEmpty();
                            })->values();
                            $photoEvents = $visualMediaEvents
                                ->filter(static fn (StoryEvent $event): bool => $event->mediaKind === 'photograph')
                                ->sortByDesc(static function (StoryEvent $event): int {
                                    // Prefer an explicitly/closely matched event image as the
                                    // chapter hero, then placement confidence and importance.
                                    return ($event->mediaMatchedEventLabel !== '' ? 1000 : 0)
                                        + ($event->mediaMatchedEventYear !== null ? 250 : 0)
                                        + ($event->mediaConfidence * 5)
                                        + $event->score;
                                })
                                ->values();
                            $documentEvents = $visualMediaEvents
                                ->reject(static fn (StoryEvent $event): bool => $event->mediaKind === 'photograph')
                                ->sortByDesc(static function (StoryEvent $event): int {
                                    return ($event->mediaMatchedEventLabel !== '' ? 500 : 0)
                                        + ($event->mediaConfidence * 5)
                                        + $event->score;
                                })
                                ->values();
                            $recordOnlyEvents = $item->events->reject(static function (StoryEvent $event): bool {
                                $target = $event->media ?? $event->fact->target();
                                return $target instanceof Media && !$target->mediaFiles()->isEmpty();
                            })->values();

                            $featuredPhoto = $photoEvents->first();
                            $supportingPhotos = $photoEvents->slice($featuredPhoto instanceof StoryEvent ? 1 : 0);
                            $visiblePhotos = $supportingPhotos->take(3);
                            $extraPhotos = $supportingPhotos->slice(3);
                            $visibleDocuments = $documentEvents->take(3);
