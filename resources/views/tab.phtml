/** @var NameResolver $nameResolver */

$plain = static function (string $value): string {
    $value = html_entity_decode($value, ENT_QUOTES | ENT_HTML5, 'UTF-8');
    return trim((string) preg_replace('/\s+/u', ' ', strip_tags($value)));
};

$fullName = $nameResolver->formalName($individual);
$nameParts = preg_split('/\s+/u', $fullName, -1, PREG_SPLIT_NO_EMPTY) ?: [];
$givenName = $nameResolver->narrativeName($individual);

$mediaRenderer = new MediaRenderer();

$renderMedia = static function (StoryEvent $event) use ($plain, $mediaRenderer, $givenName, $individual): void {
    $fact  = $event->fact;
    $media = $event->media ?? $fact->target();
    $title = $plain($fact->value());

    // The resolver normally supplies the authoritative media date and age.
    // As a final safety net, retain the date of the actual fact that owns the
    // media whenever that context was lost during grouping or de-duplication.
    $mediaYear = $event->mediaEffectiveYear;
    $mediaAge = $event->mediaAge;
    if ($mediaYear === null && $fact->date()->isOK()) {
        $candidateYear = $fact->date()->minimumDate()->year();
        if ($candidateYear > 0) {
            $mediaYear = $candidateYear;
        }
    }
    if ($mediaAge === null && $fact->date()->isOK() && $individual->getBirthDate()->isOK()) {
        $age = new Age($individual->getBirthDate(), $fact->date());
        $years = $age->ageYears();
        if ($years >= 0 && $years < 130) {
            $mediaAge = $years;
        }
    }

    if ($media instanceof Media) {
        $title = $plain($media->fullName()) ?: $title;
        echo $mediaRenderer->render($media, $title, $event->mediaKind, $event->icon, $mediaYear, $mediaAge, $givenName);
        return;
    }

    ?>
    <article class="potts-story-media-record">
        <span aria-hidden="true"><?= e($event->icon) ?></span>
        <div>
            <strong><?= e($fact->label()) ?></strong>
            <?php if ($title !== '' && $title !== 'Y') : ?><p><?= e($title) ?></p><?php endif ?>
        </div>
    </article>
    <?php
};


$renderNotes = static function (StoryEvent $event): void {
    if ($event->notes === []) {
        return;
    }

    $shortNotes = array_values(array_filter($event->notes, static fn ($note): bool => !$note->isLong));
    $longNotes = array_values(array_filter($event->notes, static fn ($note): bool => $note->isLong));
    $fact = $event->fact;
    ?>
    <div class="potts-story-event__notes" aria-label="<?= e(I18N::translate('Research notes')) ?>">
        <?php if ($shortNotes !== []) : ?>
            <aside class="potts-story-event__note potts-story-event__note--inline">
                <p class="potts-story-event__note-label"><?= I18N::plural('From the record', 'From the records', count($shortNotes)) ?></p>
                <?php foreach ($shortNotes as $note) : ?>
                    <div class="potts-story-event__note-content">
                        <?= view('fact-gedcom-fields', ['gedcom' => $note->gedcom, 'parent' => $fact->tag(), 'tree' => $fact->record()->tree()]) ?>
                    </div>
                <?php endforeach ?>
            </aside>
        <?php endif ?>

        <?php if ($longNotes !== []) : ?>
            <details class="potts-story-event__note potts-story-event__note--details">
                <summary><?= I18N::plural('%s research note', '%s research notes', count($longNotes), I18N::number(count($longNotes))) ?></summary>
                <div class="potts-story-event__note-expanded">
                    <?php foreach ($longNotes as $note) : ?>
                        <div class="potts-story-event__note-content">
                            <?= view('fact-gedcom-fields', ['gedcom' => $note->gedcom, 'parent' => $fact->tag(), 'tree' => $fact->record()->tree()]) ?>
                        </div>
                    <?php endforeach ?>
                </div>
            </details>
        <?php endif ?>
    </div>
    <?php
};

$renderEvent = static function (StoryEvent $event) use ($plain, $renderMedia, $renderNotes, $individual): void {
    if ($event->isMedia) {
        $renderMedia($event);
        return;
    }

    $fact = $event->fact;
    $date = $fact->date();
    $place = trim($fact->place()->gedcomName());
    $value = $plain($fact->value());
    $ageText = '';
    if ($event->type !== 'BIRT' && $individual->getBirthDate()->isOK() && $date->isOK()) {
        $age = new Age($individual->getBirthDate(), $date);
        $years = $age->ageYears();
        if ($years >= 0 && $years < 130) {
            $ageText = $years === 0
                ? I18N::translate('During the first year of life')
                : I18N::plural('About %s year old', 'About %s years old', $years, I18N::number($years));
        }
    }
    ?>
    <article class="potts-story-event potts-story-event--<?= e($event->importance) ?> potts-story-event--<?= e($event->accent) ?>">
        <div class="potts-story-event__marker" aria-hidden="true"><?= e($event->icon) ?></div>
        <div class="potts-story-event__body">
            <div class="potts-story-event__heading">
                <div class="potts-story-event__title-wrap">
                    <h4><?= e($fact->label()) ?></h4>
                    <?php if ($event->importance === 'major') : ?>
                        <span class="potts-story-event__key-moment"><?= I18N::translate('Key moment') ?></span>
                    <?php endif ?>
                </div>
                <?php if ($date->isOK()) : ?>
                    <time><?= $date->display() ?></time>
                <?php endif ?>
            </div>
            <?php if ($ageText !== '') : ?>
                <p class="potts-story-event__age"><?= e($ageText) ?></p>
            <?php endif ?>
            <?php if ($value !== '' && $value !== 'Y') : ?>
                <p class="potts-story-event__value"><?= e($value) ?></p>
            <?php endif ?>
            <?php if ($place !== '') : ?>
                <p class="potts-story-event__place"><?= e($place) ?></p>
            <?php endif ?>
            <?php $renderNotes($event) ?>
        </div>
    </article>
    <?php
};
